<UserControl x:Class="UltraLauncher.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UltraLauncher.App.Controls"
             x:Name="Page">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Text="Аккаунты" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,20"
                       Text="Вход выполняется на официальной странице Microsoft в вашем браузере. UltraLauncher не видит и не запрашивает пароль. Токены хранятся в зашифрованном виде (Windows DPAPI) и не попадают в журналы." />

            <!-- Не настроен Client ID -->
            <Border Style="{StaticResource Card}" Background="{StaticResource WarningBgBrush}" BorderBrush="#5C4A24"
                    Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconWarning}" Fill="{StaticResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="Вход Microsoft не настроен" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BaseText}" FontSize="13" Margin="0,4,0,0"
                               Text="Для входа нужен Client ID собственного приложения в Microsoft Entra (Azure). В поставку UltraLauncher реальные реквизиты не входят — их нельзя выдумывать или заимствовать." />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Text="1) Зарегистрируйте приложение (тип «Личные учётные записи Microsoft»), платформа «Мобильные и настольные приложения», URI перенаправления http://localhost.  2) Подайте заявку Mojang на доступ к Minecraft Services (https://aka.ms/mce-reviewappid).  3) Вставьте Client ID в «Настройки → Расширенные». Подробно — в README.md." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Открыть настройки" Style="{StaticResource PrimaryButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0" />
                        <Button Content="Документация Microsoft" Command="{Binding OpenAzureGuideCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Вход -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Добавить аккаунт" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Откроется браузер со страницей входа Microsoft. После входа лаунчер проверит профиль Xbox и наличие Minecraft: Java Edition." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource Spinner}" />
                            <TextBlock Text="Ожидание входа в браузере…" Style="{StaticResource BaseText}" Margin="10,0,12,0" VerticalAlignment="Center" />
                            <Button Content="Отменить вход" Style="{StaticResource GhostButton}" Command="{Binding CancelSignInCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SignInBlockReason}" Foreground="{StaticResource WarningBrush}" Style="{StaticResource BaseText}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding SignInBlockReason, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                            ToolTip="{Binding SignInBlockReason}" AutomationProperties.Name="Войти через Microsoft">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMicrosoft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="Войти через Microsoft" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Список аккаунтов -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Сохранённые аккаунты" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Аккаунтов пока нет." Style="{StaticResource MutedText}"
                               Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Accounts}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Surface3Brush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="15" />
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{StaticResource AccentDarkBrush}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="активный" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MicrosoftUser}" Style="{StaticResource MutedText}" FontSize="12" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding OfflineText}" Style="{StaticResource MutedText}" FontSize="12" />
                                            <TextBlock Text="{Binding SessionText}" Style="{StaticResource MutedText}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Сделать активным" Command="{Binding DataContext.SelectCommand, ElementName=Page}" CommandParameter="{Binding}" Margin="0,0,8,0"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Button Command="{Binding DataContext.RefreshCommand, ElementName=Page}" CommandParameter="{Binding}" Margin="0,0,8,0"
                                                    ToolTip="Проверить аккаунт онлайн: обновить сессию и наличие игры" AutomationProperties.Name="Проверить аккаунт"
                                                    IsEnabled="{Binding DataContext.IsBusy, ElementName=Page, Converter={StaticResource Not}}">
                                                <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                                            </Button>
                                            <Button Content="Выйти" Style="{StaticResource DangerButton}" Command="{Binding DataContext.SignOutCommand, ElementName=Page}" CommandParameter="{Binding}"
                                                    ToolTip="Выйти и удалить данные авторизации этого аккаунта с компьютера" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Офлайн -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Офлайн-режим" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Без интернета можно запустить только полностью установленную версию и только с аккаунтом, у которого ранее онлайн была подтверждена покупка Minecraft. Локальные «пиратские» профили не создаются. Мультиплеер, Realms и загрузка скинов офлайн недоступны." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
