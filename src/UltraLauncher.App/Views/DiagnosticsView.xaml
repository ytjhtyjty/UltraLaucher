<UserControl x:Class="UltraLauncher.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                <Button Command="{Binding CopyReportCommand}" Margin="0,0,8,8" ToolTip="Скопировать отчёт без токенов для обращения в поддержку" AutomationProperties.Name="Скопировать отчёт">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCopy}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock Text="Скопировать отчёт" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Margin="0,0,0,8" ToolTip="Обновить сведения о системе и Java" AutomationProperties.Name="Обновить">
                    <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="Диагностика и логи" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Журналы не содержат токенов: секреты заменяются на ***." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0">
                <ItemsControl ItemsSource="{Binding SystemInfo}" Style="{StaticResource PlainList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                         MinHeight="0" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Найденная Java" Style="{StaticResource SectionTitle}" FontSize="14" />
                    <ItemsControl ItemsSource="{Binding JavaList}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Логи лаунчера" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" FontSize="12" />
                        <Button Content="Логи игры" Command="{Binding OpenGameLogsFolderCommand}" Margin="0,0,8,8" FontSize="12" />
                        <Button Content="Отчёты о сбоях" Command="{Binding OpenCrashReportsCommand}" Margin="0,0,0,8" FontSize="12" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" MinHeight="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Журнал лаунчера" Style="{StaticResource LabelText}" />
                <Border Background="#0C0F13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}">
                    <ListBox x:Name="LauncherLogList" ItemsSource="{Binding LauncherLog}" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Журнал лаунчера">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="NoWrap" Foreground="#C9D1D9" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding GameLogTitle}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Border Background="#0C0F13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}">
                    <ListBox x:Name="GameLogList" ItemsSource="{Binding GameLog}" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Журнал игры">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="NoWrap" Foreground="#C9D1D9" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
