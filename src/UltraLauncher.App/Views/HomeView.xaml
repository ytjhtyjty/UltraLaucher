<UserControl x:Class="UltraLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UltraLauncher.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}">

            <!-- Герой-блок -->
            <Border CornerRadius="18" Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="32,28" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Minecraft: Java Edition" Style="{StaticResource MutedText}" FontSize="14" />
                        <TextBlock Style="{StaticResource BaseText}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeHero}" FontWeight="Bold" Margin="0,2,0,18">
                            <Run Text="Готовы к игре?" />
                        </TextBlock>

                        <TextBlock Text="Версия" Style="{StaticResource LabelText}" />
                        <Grid MaxWidth="460" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Catalog.Visible}" SelectedItem="{Binding SelectedVersion}" MinWidth="220" MaxDropDownHeight="360"
                                      IsEnabled="{Binding Operation.IsActive, Converter={StaticResource Not}}" AutomationProperties.Name="Версия Minecraft"
                                      ToolTip="Список из официального манифеста Mojang. Снапшоты включаются в настройках.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding TypeText}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                            <TextBlock Text="установлена" Margin="10,0,0,0" Foreground="{StaticResource AccentBrush}"
                                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="не завершена" Margin="10,0,0,0" Foreground="{StaticResource WarningBrush}"
                                                       Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Catalog.RefreshCommand}"
                                    ToolTip="Обновить список версий с сервера Mojang" AutomationProperties.Name="Обновить список версий">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Catalog.IsLoading, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" />
                            <TextBlock Text="Загрузка списка версий…" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Catalog.SourceNotice}" Foreground="{StaticResource WarningBrush}" Style="{StaticResource BaseText}" FontSize="13"
                                   Margin="0,8,0,0" Visibility="{Binding Catalog.SourceNotice, Converter={StaticResource NullToVis}}" />

                        <CheckBox Content="Офлайн-режим" IsChecked="{Binding OfflineMode}" IsEnabled="{Binding CanUseOffline}" Margin="0,18,0,0"
                                  ToolTip="{Binding OfflineReason}" AutomationProperties.Name="Офлайн-режим" />
                        <TextBlock Text="{Binding OfflineReason}" Style="{StaticResource MutedText}" FontSize="12" Margin="50,4,0,0" MaxWidth="460" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Кнопка запуска -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,0" Width="250">
                        <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{Binding PlayText}" ToolTip="{Binding PlayBlockReason}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16"
                                      Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlayText}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="190" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding PlayBlockReason}" Foreground="{StaticResource WarningBrush}" Style="{StaticResource BaseText}" FontSize="12"
                                   Margin="0,8,0,0" TextAlignment="Center" Visibility="{Binding PlayBlockReason, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding PlayNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"
                                   Visibility="{Binding PlayBlockReason, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:OperationPanel DataContext="{Binding Operation}" />

            <!-- Аккаунт -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Surface3Brush}">
                        <Path Data="{StaticResource IconAccount}" Fill="{StaticResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding AccountStatus}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Аккаунты" Command="{Binding GoToAccountsCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Справка -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Поддерживаемые версии" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SupportedRange}" Style="{StaticResource MutedText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Только vanilla. Forge, Fabric, NeoForge, модпаки и Bedrock Edition не поддерживаются. Версии загружаются с официальных серверов Mojang и проверяются по SHA-1." />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Visibility="{Binding Catalog.LatestRelease, Converter={StaticResource NullToVis}}">
                        <Run Text="Последний релиз:" /> <Run Text="{Binding Catalog.LatestRelease, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
