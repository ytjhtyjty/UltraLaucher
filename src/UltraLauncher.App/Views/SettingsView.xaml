<UserControl x:Class="UltraLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UltraLauncher.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="{StaticResource PagePadding}">
                <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Изменения применяются после нажатия «Сохранить». Настройки хранятся в %LOCALAPPDATA%\UltraLauncher\settings.json (с резервной копией)."
                           Style="{StaticResource MutedText}" Margin="0,0,0,20" />

                <!-- Папка игры -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Папка игры" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Папка игры">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameDirectoryError, Converter={StaticResource NullToVis}}" Value="Visible">
                                                <Setter Property="Tag" Value="error" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseGameDirectoryCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Command="{Binding OpenGameDirectoryCommand}" Margin="8,0,0,0" ToolTip="Открыть в проводнике" AutomationProperties.Name="Открыть папку игры">
                                <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding GameDirectoryError}" Style="{StaticResource FieldError}" Visibility="{Binding GameDirectoryError, Converter={StaticResource NullToVis}}" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"
                                   Text="Здесь хранятся версии, библиотеки, ассеты, а также ваши миры и настройки игры. Пути с пробелами и кириллицей поддерживаются. При смене папки старые файлы не переносятся и не удаляются." />
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Java" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding JavaRequirementText}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                        <RadioButton Content="Выбирать автоматически (рекомендуется)" IsChecked="{Binding JavaAuto}" GroupName="java" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="26,0,0,10"
                                   Text="Лаунчер подберёт подходящую установленную Java, а если её нет — скачает официальную Java-среду Mojang." />
                        <RadioButton Content="Указать вручную" IsChecked="{Binding JavaAuto, Converter={StaticResource Not}}" GroupName="java" Margin="0,0,0,8" />
                        <Grid Margin="26,0,0,0" IsEnabled="{Binding JavaAuto, Converter={StaticResource Not}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь к Java">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JavaPathError, Converter={StaticResource NullToVis}}" Value="Visible">
                                                <Setter Property="Tag" Value="error" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding JavaPathError}" Style="{StaticResource FieldError}" Margin="26,4,0,0" Visibility="{Binding JavaPathError, Converter={StaticResource NullToVis}}" />

                        <TextBlock Text="Найденные установки Java" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DetectedJava}" SelectedItem="{Binding SelectedDetectedJava}" DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Найденные установки Java" ToolTip="Выбор подставит путь в «Указать вручную»" />
                            <Button Grid.Column="1" Command="{Binding DetectJavaCommand}" Margin="8,0,0,0" ToolTip="Искать Java заново" AutomationProperties.Name="Искать Java">
                                <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Проверить Java" Command="{Binding CheckJavaCommand}" Margin="0,0,10,0" />
                            <Button Content="Установить Java от Mojang" Command="{Binding InstallJavaCommand}"
                                    ToolTip="Скачать официальную Java-среду Mojang для выбранной версии Minecraft (как в официальном лаунчере)" />
                        </WrapPanel>
                        <TextBlock Text="{Binding JavaCheckText}" FontSize="13" Margin="0,10,0,0" Visibility="{Binding JavaCheckText, Converter={StaticResource NullToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JavaCheckIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Память -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Оперативная память для игры" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding MemoryInfo}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Минимум (-Xms)" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="512" Maximum="{x:Static vm:SettingsViewModel.SliderMaximumMb}" SmallChange="256" LargeChange="1024" TickFrequency="256"
                                    IsSnapToTickEnabled="True" Value="{Binding MinMemoryMb}" Margin="10,0" AutomationProperties.Name="Минимальная память" />
                            <TextBox Grid.Column="2" Text="{Binding MinMemoryMb, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Минимальная память, МБ" />
                            <TextBlock Grid.Row="1" Text="Максимум (-Xmx)" Style="{StaticResource BaseText}" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="512" Maximum="{x:Static vm:SettingsViewModel.SliderMaximumMb}" SmallChange="256" LargeChange="1024" TickFrequency="256"
                                    IsSnapToTickEnabled="True" Value="{Binding MaxMemoryMb}" Margin="10,10,10,0" AutomationProperties.Name="Максимальная память" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MaxMemoryMb, UpdateSourceTrigger=LostFocus}" Margin="0,10,0,0" AutomationProperties.Name="Максимальная память, МБ" />
                        </Grid>
                        <TextBlock Text="Значения в мегабайтах. Для vanilla обычно достаточно 2–4 ГБ." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding MemoryError}" Style="{StaticResource FieldError}" Visibility="{Binding MemoryError, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Версии -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Список версий" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Показывать снапшоты (тестовые версии)" IsChecked="{Binding ShowSnapshots}" />
                        <TextBlock Text="По умолчанию показываются только стабильные релизы. Снапшоты могут повредить миры — делайте резервные копии."
                                   Style="{StaticResource MutedText}" FontSize="12" Margin="50,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Расширенные -->
                <Border Style="{StaticResource Card}">
                    <Expander Header="Расширенные настройки">
                        <StackPanel>
                            <TextBlock Text="Дополнительные аргументы JVM" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding ExtraJvmArguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Дополнительные аргументы JVM" />
                            <TextBlock Text="Например: -XX:+UseG1GC -XX:MaxGCPauseMillis=50. Значения с пробелами берите в кавычки." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding JvmArgsError}" Style="{StaticResource FieldError}" Visibility="{Binding JvmArgsError, Converter={StaticResource NullToVis}}" />

                            <TextBlock Text="Client ID приложения Microsoft (Entra ID)" Style="{StaticResource LabelText}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Client ID приложения Microsoft" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                       Text="Публичный идентификатор вашего приложения (не секрет). Клиентский секрет не нужен и не используется. Как получить Client ID и одобрение Mojang — README.md, раздел «Вход Microsoft»." />
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Ошибки и предупреждения проверки -->
                <ItemsControl ItemsSource="{Binding Issues}" Style="{StaticResource PlainList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BaseText}" FontSize="13" MaxWidth="640" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель сохранения -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сбросить по умолчанию" Style="{StaticResource GhostButton}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,10,0" />
                    <Button Content="Отменить изменения" Command="{Binding RevertCommand}" Margin="0,0,10,0" IsEnabled="{Binding IsDirty}"
                            ToolTip="Вернуть сохранённые значения" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="120"
                            ToolTip="Сохранение доступно, когда есть изменения и нет ошибок" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Text" Value="Изменений нет" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Text" Value="Есть несохранённые изменения" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter Property="Text" Value="Исправьте ошибки, чтобы сохранить" />
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
