<UserControl x:Class="UltraLauncher.App.Controls.OperationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: OperationViewModel -->
    <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" BorderBrush="#2D5C40">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,2">
                    <Run Text="{Binding StageText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                <Grid Margin="0,12,0,6">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" Height="10" />
                </Grid>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                               Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0.#}}" /><Run Text=" %" />
                    </TextBlock>
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" />
                </DockPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Отменить" Command="{Binding CancelCommand}" VerticalAlignment="Top" Margin="16,0,0,0"
                    ToolTip="Остановить операцию. Уже скачанные и проверенные файлы сохранятся." />
        </Grid>
    </Border>
</UserControl>
