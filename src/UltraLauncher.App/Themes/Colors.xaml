<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Палитра UltraLauncher: тёмная тема, зелёный акцент из иконки. -->
    <Color x:Key="BgColor">#0F1217</Color>
    <Color x:Key="SidebarColor">#12161C</Color>
    <Color x:Key="SurfaceColor">#171C23</Color>
    <Color x:Key="Surface2Color">#1E242D</Color>
    <Color x:Key="Surface3Color">#262D38</Color>
    <Color x:Key="BorderColor">#2C3440</Color>
    <Color x:Key="TextColor">#E8EDF2</Color>
    <Color x:Key="MutedColor">#97A3B1</Color>
    <Color x:Key="DisabledTextColor">#5C6673</Color>
    <Color x:Key="AccentColor">#3DDC84</Color>
    <Color x:Key="AccentHoverColor">#5BE89A</Color>
    <Color x:Key="AccentPressedColor">#2FB56B</Color>
    <Color x:Key="AccentDarkColor">#1E3A2B</Color>
    <Color x:Key="OnAccentColor">#0B1A11</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <Color x:Key="ErrorBgColor">#3A1E22</Color>
    <Color x:Key="WarningColor">#FFC15E</Color>
    <Color x:Key="WarningBgColor">#3A2F1A</Color>
    <Color x:Key="InfoColor">#6CB6FF</Color>
    <Color x:Key="InfoBgColor">#1A2A3D</Color>
    <Color x:Key="FocusColor">#8FF0B8</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B2A22" Offset="0" />
        <GradientStop Color="#151B22" Offset="0.55" />
        <GradientStop Color="#121820" Offset="1" />
    </LinearGradientBrush>

    <!-- Типографика -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeHero">34</sys:Double>

    <!-- Отступы и скругления -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="PagePadding">32,28,32,28</Thickness>

    <Duration x:Key="FastDuration">0:0:0.12</Duration>
    <Duration x:Key="NormalDuration">0:0:0.2</Duration>
</ResourceDictionary>
