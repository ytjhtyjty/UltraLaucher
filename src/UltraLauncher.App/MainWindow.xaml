<Window x:Class="UltraLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltraLauncher.App.ViewModels"
        Title="UltraLauncher"
        Icon="pack://application:,,,/Assets/ultralauncher.ico"
        Width="1140" Height="740" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NoticeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource InfoBgBrush}" />
            <Setter Property="BorderBrush" Value="#2B4766" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="#2D5C40" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                    <Setter Property="BorderBrush" Value="#5C4A24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
                    <Setter Property="BorderBrush" Value="#5A2A30" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- В развёрнутом окне WindowChrome выходит за край экрана — компенсируем. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Боковая панель ============ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,14,14,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,26">
                        <Image Source="pack://application:,,,/Assets/ultralauncher.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="UltraLauncher" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding Version, StringFormat=Minecraft Java · v{0}}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Аккаунт и статус игры внизу -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="{StaticResource Radius}" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GameStatus}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Content="Завершить принудительно" Style="{StaticResource GhostButton}" FontSize="12" Margin="-8,4,0,-4"
                                        HorizontalAlignment="Left" Command="{Binding StopGameCommand}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8" Command="{Binding NavigateCommand}" CommandParameter="accounts"
                                ToolTip="Управление аккаунтами">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface3Brush}">
                                    <Path Data="{StaticResource IconAccount}" Fill="{StaticResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SidebarAccount}" Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                    <TextBlock Text="{Binding SidebarAccountStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Normal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="NavPanel">
                        <RadioButton Style="{StaticResource NavButton}" IsChecked="True" Content="Главная" Tag="{StaticResource IconHome}" GroupName="nav" CommandParameter="home" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Установка и загрузки" Tag="{StaticResource IconDownload}" GroupName="nav" CommandParameter="downloads" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Аккаунты" Tag="{StaticResource IconAccount}" GroupName="nav" CommandParameter="accounts" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Настройки" Tag="{StaticResource IconSettings}" GroupName="nav" CommandParameter="settings" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Диагностика и логи" Tag="{StaticResource IconDiagnostics}" GroupName="nav" CommandParameter="diagnostics" Checked="Nav_Checked" />

                        <!-- Мини-индикатор операции, видимый с любой страницы -->
                        <Border Margin="0,18,0,0" Padding="12" CornerRadius="{StaticResource Radius}" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding Operation.IsActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" />
                                    <TextBlock Text="{Binding Operation.Title}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                                <ProgressBar Margin="0,8,0,0" Height="4" Value="{Binding Operation.Progress}" Maximum="100" IsIndeterminate="{Binding Operation.IsIndeterminate}" />
                                <TextBlock Text="{Binding Operation.StageText}" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Контент ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок окна (перетаскивание — через WindowChrome) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Свернуть"
                            AutomationProperties.Name="Свернуть">
                        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть">
                        <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Data="{StaticResource IconClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Уведомление -->
                <Border Grid.Row="1" Margin="32,0,32,8" DataContext="{Binding Notifications}" Style="{StaticResource NoticeBorder}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" x:Name="Notice">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,12,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconInfo}" />
                                    <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                                            <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                            <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                            <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                       Visibility="{Binding Hint, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding DismissCommand}" ToolTip="Закрыть уведомление"
                                VerticalAlignment="Top" Margin="8,-4,-6,0" AutomationProperties.Name="Закрыть уведомление">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Страница с анимацией смены -->
                <ContentControl Grid.Row="2" x:Name="PageHost" Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                    <DoubleAnimation Storyboard.TargetName="PageShift" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.26">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                </ContentControl>
            </Grid>

            <!-- ============ Диалог подтверждения ============ -->
            <Grid Grid.ColumnSpan="2" DataContext="{Binding Dialog}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" Background="#B0080A0D">
                <Border Width="460" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,20" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,10,0" />
                            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="Foreground" Value="#2A0B0E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
